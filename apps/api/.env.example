# Relwick API — copier vers .env et ajuster (voir RELWICK.md A11)

NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://root:@localhost:3306/relwick"
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=false
# Secrets JWT ≥ 32 caractères (générer des chaînes aléatoires uniques)
JWT_ACCESS_SECRET=change-me-64-caracteres-aleatoires-minimum-trente-deux
JWT_REFRESH_SECRET=change-me-autre-64-caracteres-minimum-trente-deux-chars
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
ADMIN_EMAIL=elios6546@gmail.com
ADMIN_PASSWORD=change-me-au-premier-lancement
ADMIN_NAME="Elios Ngombe"
GEOIP_CITY_DB=./geo/GeoLite2-City.mmdb
GEOIP_ASN_DB=./geo/GeoLite2-ASN.mmdb
DEV_FAKE_IP=
RETENTION_DAYS=395
APP_TIMEZONE=Africa/Lubumbashi
